# Docker infrastructure
POSTGRES_DB=mediconnect
POSTGRES_USER=mediconnect
POSTGRES_PASSWORD=change-me
MONGO_ROOT_USERNAME=mediconnect
MONGO_ROOT_PASSWORD=change-me

# Spring production profile
DB_URL=jdbc:postgresql://localhost:5432/mediconnect
DB_USERNAME=mediconnect
DB_PASSWORD=change-me
MONGO_URI=mongodb://mediconnect:change-me@localhost:27017/mediconnect?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT: HS512 requires a secret of at least 64 bytes
JWT_SECRET=replace-with-at-least-64-random-characters-before-running-the-app-123456789
JWT_EXPIRATION_MINUTES=60

# Optional dev bootstrap admin
DEV_ADMIN_EMAIL=admin@mediconnect.local
DEV_ADMIN_PASSWORD=ChangeThisAdminPassword123!
